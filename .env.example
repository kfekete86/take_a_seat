# Facebook Page Access Token
# Get this from: https://developers.facebook.com/tools/explorer/
# Required permissions: pages_manage_posts, pages_read_engagement
FACEBOOK_PAGE_ACCESS_TOKEN=your_page_access_token_here

# Facebook Page ID
# Find this in your Facebook Page settings
FACEBOOK_PAGE_ID=your_page_id_here

# Cron schedule for checking new results (default: every hour)
# Format: minute hour day month weekday
# Example: "0 * * * *" means every hour at minute 0
CRON_SCHEDULE=0 * * * *

# Enable/disable automatic posting (true/false)
AUTO_POST_ENABLED=true

# F1 season year (leave empty for current year)
F1_SEASON=

# Log level (error, warn, info, debug)
LOG_LEVEL=info
